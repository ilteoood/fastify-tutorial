---
import { getCollection } from 'astro:content';
import HeadTags from '../components/HeadTags.astro';
import FastifyMark from '../components/FastifyMark.astro';
import '../styles/home.css';

const entries = await getCollection('tutorial');
const byOrder = (a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id, undefined, { numeric: true });

type TutorialEntry = (typeof entries)[number];
type EntryOf<T extends TutorialEntry['data']['type']> = TutorialEntry & {
  data: Extract<TutorialEntry['data'], { type: T }>;
};

const parts = entries
  .filter((entry): entry is EntryOf<'part'> => entry.data.type === 'part')
  .sort(byOrder);
const chapters = entries
  .filter((entry): entry is EntryOf<'chapter'> => entry.data.type === 'chapter')
  .sort(byOrder);
const lessons = entries
  .filter((entry): entry is EntryOf<'lesson'> => entry.data.type === 'lesson')
  .sort(byOrder);

const curriculum = parts.map((part) => {
  const partSlug = part.id.split('/')[0];
  const partChapters = chapters
    .filter((chapter) => chapter.id.startsWith(`${partSlug}/`))
    .map((chapter) => {
      const chapterSlug = chapter.id.split('/')[1];
      const chapterLessons = lessons.filter((lesson) => lesson.id.startsWith(`${partSlug}/${chapterSlug}/`));
      const firstLesson = chapterLessons[0];

      return {
        title: chapter.data.title,
        href: firstLesson ? `/${partSlug}/${chapterSlug}/${firstLesson.id.split('/')[2]}` : `/${partSlug}/${chapterSlug}`,
        lessons: chapterLessons.length,
      };
    });

  return {
    title: part.data.title,
    lessons: partChapters.reduce((total, chapter) => total + chapter.lessons, 0),
    chapters: partChapters,
  };
});

const firstLessonHref = curriculum[0]?.chapters[0]?.href ?? '/';

const endpoints = [
  { method: 'GET', path: '/api/tasks', description: 'List every task' },
  { method: 'POST', path: '/api/tasks', description: 'Create a task' },
  { method: 'GET', path: '/api/tasks/:id', description: 'Read one task' },
  { method: 'PATCH', path: '/api/tasks/:id', description: 'Update a task' },
  { method: 'DELETE', path: '/api/tasks/:id', description: 'Remove a task' },
];

const stack = [
  { name: 'Fastify 5', detail: 'the framework behind every route' },
  { name: 'JSON Schema', detail: 'one schema validates request and response' },
  { name: 'node:test', detail: 'the test runner that ships with Node' },
  { name: 'Pino', detail: 'structured logs for every request' },
  { name: '@fastify/autoload', detail: 'one file per route, loaded from disk' },
];

const socialImage = new URL('/og-image.png', Astro.site);

const steps = [
  {
    title: 'Read',
    text: 'Each lesson explains one idea in a few paragraphs and shows the file it changes right next to the code.',
  },
  {
    title: 'Change',
    text: 'Edit the files in the browser editor and press Solve whenever you want to compare with the reference solution.',
  },
  {
    title: 'Run',
    text: 'Start the server from the terminal panel and call it with curl. The output panel prints every request.',
  },
];

const serverCode = `<code><span class="code__keyword">import</span> Fastify <span class="code__keyword">from</span> <span class="code__string">'fastify'</span>;

<span class="code__keyword">const</span> fastify = Fastify({ logger: <span class="code__keyword">true</span> });

fastify.get(<span class="code__string">'/'</span>, <span class="code__keyword">async</span> () =&gt; {
  <span class="code__keyword">return</span> { hello: <span class="code__string">'world'</span> };
});

<span class="code__keyword">await</span> fastify.listen({ port: 3000 });</code>`;

const serverLog = `{"level":30,"time":"...","msg":"Server listening at http://127.0.0.1:3000"}`;
const curlOutput = `{"hello":"world"}<span class="terminal__cursor" aria-hidden="true"></span>`;

const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;

const sunIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`;
const moonIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>`;
const menuIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>`;
const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <HeadTags>
      <title slot="title">Fastify Tutorial — build a REST API in your browser</title>
      <Fragment slot="meta">
        <meta
          name="description"
          content="An interactive Fastify tutorial: 42 hands-on lessons that take you from your first server to a validated, tested and secured REST API, running entirely in your browser."
        />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Fastify Tutorial — build a REST API in your browser" />
        <meta
          property="og:description"
          content="42 hands-on lessons that take you from your first server to a validated, tested and secured REST API, running entirely in your browser."
        />
        <meta property="og:image" content={socialImage} />
        <meta property="og:url" content={Astro.site} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:title" content="Fastify Tutorial — build a REST API in your browser" />
        <meta
          name="twitter:description"
          content="42 hands-on lessons that take you from your first server to a validated, tested and secured REST API, running entirely in your browser."
        />
      </Fragment>
    </HeadTags>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=JetBrains+Mono:wght@100..800&family=Space+Grotesk:wght@300..700&display=swap"
    />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('tk_theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';

        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__bar"></div>

      <nav class="site-header__inner container" aria-label="Main">
        <a class="brand" href="/" aria-label="Fastify tutorial home">
          <span class="brand__mark"><FastifyMark /></span>
          <span class="brand__name">fastify</span>
          <span class="brand__suffix">tutorial</span>
        </a>

        <ul class="nav">
          <li><a class="nav__link" href="#curriculum">Curriculum</a></li>
          <li><a class="nav__link" href="#api">The API</a></li>
          <li><a class="nav__link" href="#how-it-works">How it works</a></li>
        </ul>

        <div class="header-actions">
          <button
            class="icon-button nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Open the menu"
            data-nav-toggle
          >
            <Fragment set:html={menuIcon} />
          </button>

          <button class="icon-button" type="button" aria-label="Switch the theme" data-theme-toggle>
            <span class="theme-toggle__sun"><Fragment set:html={sunIcon} /></span>
            <span class="theme-toggle__moon"><Fragment set:html={moonIcon} /></span>
          </button>

          <a
            class="icon-button"
            href="https://github.com/ilteoood/fastify-tutorial"
            aria-label="Tutorial repository on GitHub"
          >
            <Fragment set:html={githubIcon} />
          </a>

          <a class="button button--primary header-cta" href={firstLessonHref}>Start the tutorial</a>
        </div>
      </nav>

      <div class="mobile-nav" id="mobile-nav" hidden>
        <a class="mobile-nav__link" href="#curriculum">Curriculum</a>
        <a class="mobile-nav__link" href="#api">The API</a>
        <a class="mobile-nav__link" href="#how-it-works">How it works</a>
        <a class="mobile-nav__link" href={firstLessonHref}>Start the tutorial</a>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero__glow" aria-hidden="true"></div>

        <div class="hero__inner container">
          <div>
            <div class="hero__lockup">
              <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" viewBox="0 0 6747 2071" role="img" aria-label="Fastify">
                <path
                  fill="currentColor"
                  d="m6603 332 97-250-4-16-956 252c102-148 67-266 67-266s-305 195-536 190-305-67-659 46-454 459-557 534c-102 74-423 321-423 321l290-93s-82 78-251 305v1c27 38 146 195 264 161 13-4 28-11 45-19 53 30 124 59 201 67 0 0-52-60-96-130l36-23-6 4 111 40-12-104h1l108 40-13-95 41-20 113-428 468-320-37 94c-95 233-273 288-273 288l-74 29c-56 65-79 81-98 301 45-12 87-14 126-4 200 54 269 295 215 362-13 16-45 45-86 78h-81l-1 66-8 7h-83l-1 64-22 16c-77 2-176-66-176-66 1 62 52 157 52 157l9-5-8 6s208 138 339 87c116-46 417-283 677-395l786-208 104-268-599 158v-242l703-185 104-269-807 213V572ZM5176 843l187-49 2 9-58 151-193 51zm64 323-193 51 63-162 186-49 3 9zm252-54-193 51 63-162 186-49 3 9z"
                ></path>
                <g fill="currentColor">
                  <path
                    d="m187 657 6-31c17-90 51-167 114-225 46-43 114-69 191-69 49 0 86 7 109 15l-43 148c-18-6-35-9-60-9-69 0-109 72-122 138l-6 33h146l-26 135H353l-119 618H42l118-618m657 618 6-126h-5c-60 100-132 138-192 138-110 0-164-94-164-226 0-228 114-552 438-552 75 0 151 13 197 31l-83 419c-18 88-32 234-31 316zm69-618c-15-3-29-4-40-4-126 0-194 251-196 362 0 66 10 114 57 114 53 0 102-87 130-224zm234 453c31 17 68 32 122 31 56-2 86-37 86-85 0-42-20-71-72-112-65-53-96-119-96-184 0-138 108-251 279-251 67 0 114 12 142 28l-42 140c-21-12-57-23-89-23-62 0-100 32-100 83 0 39 22 62 57 91 85 65 113 139 113 197 0 167-116 259-289 259-69 0-131-20-157-38zm851-792-39 204h296l-25 135h-297l-66 350c-5 26-6 49-6 63 0 46 23 63 58 63 14 0 34 0 52-3l-23 145c-35 9-78 12-115 12-116 0-173-64-173-166 0-34 6-76 14-113l66-351h-87l26-136h88l30-155z"
                  ></path>
                  <path
                    d="m2017 1410 145-753h192l-144 753zm180-946c0-56 40-119 108-119 63 0 93 48 91 100-2 77-54 121-111 121-62 0-89-45-88-102m277 193 6-31c17-90 51-167 114-225 46-43 114-69 191-69 49 0 86 7 109 15l-43 148c-18-6-35-9-60-9-69 0-109 72-121 138l-7 33h224l-26 135h-221l-118 618h-193l119-618"
                  ></path>
                  <path
                    d="m3007 657 5 362c1 71 3 123 1 178h3c16-61 31-112 57-192l114-349h194l-246 594c-74 172-159 317-251 402-45 41-97 74-129 87l-77-157c33-17 69-37 100-61 43-36 84-79 103-121 3-10 6-18 4-33l-80-711h202z"
                  ></path>
                </g>
              </svg>
            </div>

            <p class="badge">
              <span class="badge__dot" aria-hidden="true"></span>
              <span class="badge__text">Fastify v5 · Node.js 20+</span>
            </p>

            <h1 class="hero__title">
              Build a real Fastify API, <span class="text-velocity">right in your browser.</span>
            </h1>

            <p class="hero__lede">
              {lessons.length} hands-on lessons from your first server to a validated, tested and secured REST
              API. You edit the files, start the server and call it from the terminal, all on this page.
            </p>

            <div class="hero__actions">
              <a class="button button--primary" href={firstLessonHref}>
                Start the tutorial
                <Fragment set:html={arrowIcon} />
              </a>

              <div class="install">
                <span class="install__prompt" aria-hidden="true">$</span>
                <code class="install__code">npm install fastify</code>
                <button
                  class="install__copy"
                  type="button"
                  data-copy="npm install fastify"
                  aria-label="Copy the install command"
                >
                  <span class="install__copy-icon install__copy-icon--copy"><Fragment set:html={copyIcon} /></span>
                  <span class="install__copy-icon install__copy-icon--copied"><Fragment set:html={checkIcon} /></span>
                </button>
              </div>
            </div>

            <dl class="stats">
              <div class="stat">
                <dt class="stat__label">Lessons</dt>
                <dd class="stat__value">{lessons.length}</dd>
              </div>
              <div class="stat">
                <dt class="stat__label">Chapters</dt>
                <dd class="stat__value">{chapters.length}</dd>
              </div>
              <div class="stat">
                <dt class="stat__label">Endpoints</dt>
                <dd class="stat__value">{endpoints.length}</dd>
              </div>
            </dl>
          </div>

          <div class="hero__visual">
            <div class="workspace">
              <div class="workspace__head">
                <span class="workspace__label">src/server.js</span>
                <span class="workspace__status"><span class="workspace__dot" aria-hidden="true"></span>live</span>
              </div>

              <pre class="code" set:html={serverCode}></pre>

              <div class="terminal">
                <p><span class="terminal__prompt" aria-hidden="true">$</span> npm start</p>
                <p class="terminal__output" set:html={serverLog}></p>
                <p>
                  <span class="terminal__prompt" aria-hidden="true">$</span> curl http://127.0.0.1:3000
                </p>
                <p class="terminal__output" set:html={curlOutput}></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section container" id="api">
        <div class="split">
          <div>
            <p class="eyebrow">// what you will build</p>
            <h2 class="section__title">The Tasks API</h2>
            <p class="section__lead">
              Five routes over one resource. Small enough to understand in an afternoon, complete enough to show
              how a real service is put together.
            </p>
          </div>

          <div>
            <div class="card">
              <ul>
                {
                  endpoints.map((endpoint) => (
                    <li class="endpoint">
                      <span class="endpoint__method">{endpoint.method}</span>
                      <code class="endpoint__path">{endpoint.path}</code>
                      <span class="endpoint__description">{endpoint.description}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <ul class="stack">
          {
            stack.map((item) => (
              <li class="stack__item">
                <span class="stack__name">{item.name}</span>
                <span class="stack__detail">{item.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section container" id="curriculum">
        <p class="eyebrow">// curriculum</p>
        <h2 class="section__title">{lessons.length} lessons, {curriculum.length} parts</h2>
        <p class="section__lead">
          Each part adds one idea to the same growing project, so the API you finish with is the API you built
          one lesson at a time.
        </p>

        <div class="parts">
          {
            curriculum.map((part, index) => (
              <article class="card part">
                <div class="part__head">
                  <span class="part__index">{String(index + 1).padStart(2, '0')}</span>
                  <h3 class="part__title">{part.title}</h3>
                </div>
                <p class="part__meta">
                  {part.lessons} lessons · {part.chapters.length} chapters
                </p>

                <ul class="chapter-list">
                  {part.chapters.map((chapter) => (
                    <li class="chapter">
                      <a class="chapter__link" href={chapter.href}>
                        <span>{chapter.title}</span>
                        <span class="chapter__count">{chapter.lessons}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section container" id="how-it-works">
        <p class="eyebrow">// how it works</p>
        <h2 class="section__title">Read it, change it, run it</h2>
        <p class="section__lead">
          Every lesson works the same way, so you always know what to do next and what the browser is doing for
          you.
        </p>

        <div class="steps">
          {
            steps.map((step, index) => (
              <div class="step">
                <span class="step__index">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="cta">
        <div class="cta__inner container">
          <div>
            <h2 class="cta__title">Start with the first server</h2>
            <p class="cta__text">Everything runs in your browser. No install, no account, no setup.</p>
          </div>

          <div class="cta__actions">
            <a class="button button--primary" href={firstLessonHref}>
              Start the tutorial
              <Fragment set:html={arrowIcon} />
            </a>
            <a class="button button--ghost" href="#curriculum">Browse the curriculum</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer__inner container">
        <div class="footer__grid">
          <div>
            <a class="brand" href="/" aria-label="Fastify tutorial home">
              <span class="brand__mark"><FastifyMark /></span>
              <span class="brand__name">fastify</span>
              <span class="brand__suffix">tutorial</span>
            </a>
            <p class="footer__description">
              An interactive Fastify tutorial: build, test and ship a small REST API step by step, right in your
              browser.
            </p>
          </div>

          <div>
            <h3 class="footer__heading">Tutorial</h3>
            <ul class="footer__list">
              <li><a class="footer__link" href={firstLessonHref}>Start the tutorial</a></li>
              <li><a class="footer__link" href="#curriculum">Curriculum</a></li>
              <li><a class="footer__link" href="#api">The Tasks API</a></li>
              <li><a class="footer__link" href="#how-it-works">How it works</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer__heading">Fastify</h3>
            <ul class="footer__list">
              <li>
                <a class="footer__link" href="https://fastify.dev/docs/latest/Guides/Getting-Started/">
                  Getting started
                </a>
              </li>
              <li>
                <a class="footer__link" href="https://fastify.dev/docs/latest/Reference/">Reference</a>
              </li>
              <li><a class="footer__link" href="https://fastify.dev/ecosystem/">Ecosystem</a></li>
              <li><a class="footer__link" href="https://fastify.dev/benchmarks/">Benchmarks</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer__heading">Community</h3>
            <ul class="footer__list">
              <li>
                <a class="footer__link" href="https://github.com/ilteoood/fastify-tutorial">Tutorial repository</a>
              </li>
              <li><a class="footer__link" href="https://github.com/fastify/fastify">Fastify on GitHub</a></li>
              <li><a class="footer__link" href="https://discord.gg/fastify">Discord</a></li>
              <li>
                <a class="footer__link" href="https://stackoverflow.com/questions/tagged/fastify">
                  Stack Overflow
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="footer__bottom">
          <span>© 2025 Fastify tutorial contributors</span>
          <span class="footer__separator" aria-hidden="true">·</span>
          <a class="footer__link" href="https://fastify.dev/">fastify.dev</a>
          <span class="footer__separator" aria-hidden="true">·</span>
          <a class="footer__link" href="https://github.com/ilteoood/fastify-tutorial">Source</a>
        </div>
      </div>
    </footer>

    <script>
      const themeToggle = document.querySelector('[data-theme-toggle]');

      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';

        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('tk_theme', next);
      });

      const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');

      copyButton?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');

        copyButton.dataset.copied = 'true';

        window.setTimeout(() => {
          delete copyButton.dataset.copied;
        }, 2000);
      });

      const navToggle = document.querySelector('[data-nav-toggle]');
      const mobileNav = document.querySelector('#mobile-nav');

      const closeMobileNav = () => {
        navToggle?.setAttribute('aria-expanded', 'false');
        navToggle?.setAttribute('aria-label', 'Open the menu');
        mobileNav?.toggleAttribute('hidden', true);
      };

      navToggle?.addEventListener('click', () => {
        const open = navToggle.getAttribute('aria-expanded') === 'true';

        navToggle.setAttribute('aria-expanded', String(!open));
        navToggle.setAttribute('aria-label', open ? 'Open the menu' : 'Close the menu');
        mobileNav?.toggleAttribute('hidden', open);
      });

      mobileNav?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) {
          closeMobileNav();
        }
      });
    </script>
  </body>
</html>
